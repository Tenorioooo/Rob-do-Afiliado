# ==============================================================================
# AFFILIATE AI (ROBÔ DO AFILIADO) — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# ATENÇÃO: Nunca insira chaves reais neste arquivo. Copie para .env e preencha
# com suas credenciais oficiais obtidas nos portais de desenvolvedores.

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO & SEGURANÇA BÁSICA
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Chave mestra de 32 bytes para criptografia AES-256-GCM de credenciais em repouso
INTEGRATION_ENCRYPTION_KEY=

# Banco de dados SQLite / Postgres
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. GLOBAL & PROVIDER KILL SWITCHES (FASE 7.2)
# ------------------------------------------------------------------------------
# Switch mestre para permitir ou bloquear todos os envios reais externos
REAL_DISPATCH_ENABLED=false

# Switches individuais por provedor (devem ser 'true' para liberar o canal correspondente)
TELEGRAM_ENABLED=false
DISCORD_ENABLED=false
WHATSAPP_ENABLED=false
MERCADOLIVRE_ENABLED=false
SHOPEE_ENABLED=false
AMAZON_ENABLED=false

# ------------------------------------------------------------------------------
# 3. CANAIS DE MENSAGERIA & DISTRIBUIÇÃO
# ------------------------------------------------------------------------------

# Telegram Bot API (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Discord (Incoming Webhooks & Bot REST API v10)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# WhatsApp Meta Cloud API (Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# 4. MARKETPLACES & PROGRAMAS DE AFILIADOS
# ------------------------------------------------------------------------------

# Mercado Livre Developers (OAuth 2.0)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=http://localhost:3000/api/integrations/oauth/mercadolivre/callback

# Shopee Affiliate Open API (Exige aprovação de parceiro)
SHOPEE_APP_ID=
SHOPEE_API_SECRET=

# Amazon Associates PA-API 5.0 (Exige conta qualificada no programa de associados)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=br
