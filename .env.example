# ==============================================================================
# AFFILIATE AI (ROBÔ DO AFILIADO) — ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION / VERCEL)
# ==============================================================================
# ATENÇÃO: Nunca insira chaves reais neste arquivo. Copie para .env (ou configure
# na Vercel Project Settings > Environment Variables).

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO & INFRAESTRUTURA
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# URL pública oficial de produção (Vercel ou domínio customizado com HTTPS)
APP_PUBLIC_URL=https://seu-dominio.vercel.app
NEXTAUTH_URL=https://seu-dominio.vercel.app
APP_URL=https://seu-dominio.vercel.app
APP_NAME="Affiliate AI"

# Segredo de sessão JWT
JWT_SECRET=

# Chave mestra de 32 bytes para criptografia AES-256-GCM de credenciais em repouso
INTEGRATION_ENCRYPTION_KEY=

# Banco de dados PostgreSQL (ex: Supabase, Neon, AWS RDS, Railway)
# Para conexão com pooler no Supabase/Neon utilize a porta do pooler (ex: 6543 / ?pgbouncer=true)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# 2. GLOBAL & PROVIDER KILL SWITCHES
# ------------------------------------------------------------------------------
# Switch mestre para permitir ou bloquear todos os envios reais externos
REAL_DISPATCH_ENABLED=false

# Switches individuais por provedor (devem ser 'true' para liberar o canal correspondente)
TELEGRAM_ENABLED=false
DISCORD_ENABLED=false
WHATSAPP_ENABLED=false
MERCADOLIVRE_ENABLED=false
SHOPEE_ENABLED=false
AMAZON_ENABLED=false

# ------------------------------------------------------------------------------
# 3. CANAIS DE MENSAGERIA & DISTRIBUIÇÃO
# ------------------------------------------------------------------------------

# Telegram Bot API (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Discord (Incoming Webhooks & Bot REST API v10)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# WhatsApp Meta Cloud API (Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------------------
# 4. MARKETPLACES & PROGRAMAS DE AFILIADOS
# ------------------------------------------------------------------------------

# Mercado Livre Developers (OAuth 2.0)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://seu-dominio.vercel.app/api/integrations/oauth/mercadolivre/callback

# Shopee Affiliate Open API (Exige aprovação de parceiro)
SHOPEE_APP_ID=
SHOPEE_API_SECRET=

# Amazon Associates PA-API 5.0 (Exige conta qualificada no programa de associados)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=br
